// SCOPE ATC Grammar — G_ATC unified
// Derived from ICAO Doc 4444 Chapter 12 and FAA JO 7110.65BB
// Cross-referenced against LDC ATC Corpus (1,326 pairs)
// Regulatory-first, corpus-validated construction 

start : utterance

utterance : callsign_phrase " " body       // controller addressed instruction
          | body                            // controller unaddressed
          | callsign_phrase                 // bare callsign acknowledgement
          | pilot_utterance                 // pilot readback / report / request

// ── Body: one or more instructions, optionally preceded by facility ack ─────
body : facility_ack " " instruction_chain    // "BOSTON APPROACH ROGER X"
     | instruction_chain

// Optional facility identification + acknowledgment before main instruction
facility_ack : facility_name " " acknowledgment
             | facility_name
             | acknowledgment

facility_name : /[A-Z][A-Z ]+(?:APPROACH|CENTER|TOWER|GROUND|DEPARTURE|ARRIVAL|CONTROL|RADAR)/
              | "BOSTON APPROACH" | "BOSTON" | "APPROACH" | "TOWER"
              | "GROUND" | "CENTER" | "DEPARTURE" | "ARRIVAL" | "CONTROL"

acknowledgment : "ROGER" | "WILCO" | "AFFIRM" | "NEGATIVE" | "UNABLE"
               | "GOOD AFTERNOON" | "GOOD MORNING" | "GOOD EVENING"
               | "GOOD DAY" | "HAVE A GOOD DAY" | "HAVE A GOOD ONE"
               | "THANK YOU" | "THANKS" | "SEE YOU"

// ── Callsign: alpha-numeric OR multi-word spoken callsign ─────────────────
callsign_phrase : alpha_callsign | spoken_callsign

alpha_callsign : /[A-Z]{1,3}[-]?[0-9]{1,6}[A-Z]{0,3}/  // N12345, UAV007, AAL123

spoken_callsign : airline_word (" " number_word)+ (" " "HEAVY")?
                | airline_word (" " airline_word)+ (" " number_word)+ (" " "HEAVY")?
                | airline_word (" " (number_word | airline_word))+ (" " "HEAVY")?  // mixed: NOVEMBER TWO SIX GOLF ALPHA
                | alpha_callsign (" " "HEAVY")?

airline_word : "AMERICAN" | "UNITED" | "DELTA" | "CONTINENTAL" | "NORTHWEST"
             | "CLIPPER" | "SWISSAIR" | "ATLANTIC" | "CANADA" | "AIR"
             | "LINK" | "TRUMP" | "BIZEX" | "RIPIT" | "LONER" | "MIDEX"
             | "VIRGIN" | "ZANTOP" | "LUFTHANSA" | "SHAMROCK" | "EAGLE"
             | "MOHAWK" | "ALLEGHENY" | "COMMUTER" | "METRO" | "NAVAJO"
             | "GULFSTREAM" | "JET" | "US" | "TWA" | "T" | "W" | "U" | "S"
             | "NERA" | "MIDWAY" | "WAYNE" | "SIERRA" | "NOVEMBER"
             | "UAV" | "DRONE" | "FLIGHT" | "EXPRESS" | "SHUTTLE"
             | /[A-Z]/  // any uppercase word (airline callsigns are not enumerable)  single letter: T, W, A, U, S, etc.
             // Callsigns found in LDC corrected corpus validation:
             | "HENSON" | "ASEA" | "REGIONAL" | "PACER" | "PRECISION"
             | "NIGHTHAWK" | "VENUS" | "CONDOR" | "BARON" | "HUSTLER"
             | "ARMY" | "CESSNA" | "MEDSTAR" | "JETEX" | "CITATION" | "ROSS"
             | "ARMY" | "PAD" | "NASA" | "NAVY" | "PACER" | "ROSS"
             | "VENUS" | "LANCE" | "CONDOR" | "ATLANTIC" | "CHEROKEE"
             | "ROSS" | "SKYLANE"
             | "CROWN" | "SOUTHWEST" | "CACTUS" | "WESTWIND" | "BLUE"
             | "RIDGE" | "PAD" | "KING" | "DEPARTURE" | "WASHINGTON"
             | "CONTINENTAL" | "ALLEGHENY" | "PIEDMONT" | "EASTERN"
             | "BRANIFF" | "OZARK" | "REPUBLIC" | "SUNBIRD" | "HORIZON"
             | "NASA" | "BOXER" | "NAVY" | "PACER"
             | "LEARJET" | "MOONEY" | "CHEROKEE" | "FALCON" | "ARROW" | "BARON" | "MALIBU" | "CHAPARRAL" | "TWIN"
             | "PAT" | "RED" | "BIRD" | "LANCE" | "ROSS" | "PORT" | "MARTINAIRE" | "CARE" | "CAR"
             | "FIRST" | "TWIN" | "SKYLANE" | "NIGHTHAWK" | "VENUS"
             // Add to airline_word:
             | "JULIETT"  // double-T spelling used in LDC corpus for J-airways
             | "ALPHA" | "BRAVO" | "CHARLIE" | "ECHO" | "FOXTROT"
             | "GOLF" | "HOTEL" | "INDIA" | "JULIET" | "KILO" | "LIMA"
             | "MIKE" | "OSCAR" | "PAPA" | "QUEBEC" | "ROMEO" | "TANGO"
             | "UNIFORM" | "VICTOR" | "WHISKEY" | "XRAY" | "YANKEE" | "ZULU"

// ── Instruction chain: one or more instructions joined by AND ────────────
instruction_chain : ack_only " " instruction (" " ("AND" " ")? instruction)*
                  | instruction (" " ("AND" " ")? instruction)*

// ── Top-level instruction types ────────────────────────────────────────────
instruction : altitude_instr
            | heading_instr
            | speed_instr
            | frequency_instr
            | clearance_instr
            | taxi_instr
            | takeoff_instr
            | approach_instr
            | hold_instr
            | readback_instr
            | report_instr
            | ident_instr
            | traffic_info
            | ack_only
            | general_instr
            | radar_contact_instr
            | confirm_instr
            | join_instr
            | route_instr
            | leaving_instr
            | information_instr

// ── Acknowledgment-only ────────────────────────────────────────────────────
ack_only : acknowledgment
         | "LOOKING" " " "OUT"               // visual separation acquired
         | "NEGATIVE" " " "CONTACT"           // traffic not acquired
         | "NEGATIVE" " " "RADAR" " " "CONTACT"
         | "SAY" " " "SQUAWK"                 // controller requesting squawk
         | "CORRECTION"                        // mid-utterance self-correction repair token

// ── Level / Altitude instructions ─────────────────────────────────────────
altitude_instr : climb_descend_instr
               | "MAINTAIN" " " level
               | "MAINTAINING" " " level
               | "MAINTAIN" " " "FLIGHT LEVEL" " " fl_value
               | "MAINTAIN" " " "VISUAL" " " "SEPARATION" " " "FROM" " " report_type
               | "CROSS" " " waypoint " " "AT" " " level (" " "OR" " " "ABOVE")?
               | "CROSS" " " waypoint " " level (" " "OR" " " "ABOVE")?
               | "EXPECT" " " level
               | "DESCEND" " " "TO" " " level
               | "CLIMB" " " "TO" " " level
               | "STOP" " " climb_descend " " "AT" " " level
               | "LEVEL" " " ("AT" " ")? level
               | "LEVEL" " " "OFF"
               | "CLIMBING" " " "TO" " " level
               | "DESCENDING" " " "TO" " " level
               | "CLIMBING" " " "AND" " " "MAINTAINING" " " level
               | "DESCENDING" " " "FROM" " " level
               | "EXPEDITE" " " climb_descend_instr     // EXPEDITE CLIMB AND MAINTAIN
               | "EXPEDITE" " " "CLIMB" (" " "THROUGH" " " level)?
               | "EXPEDITE" " " "DESCENT" (" " "THROUGH" " " level)?
               | "EXPEDITING" " " "CLIMB" (" " "THROUGH" " " level)?
               | "EXPEDITING" " " "DESCENT" (" " "THROUGH" " " level)?
               | "EXPECT" " " "FURTHER" " " ("DESCENT"|"CLIMB") " " "IN" " " number_word (" " number_word)* " " "MILES"

climb_descend_instr : climb_descend " " "AND" " " "MAINTAIN" " " level ("," " " report_point)?
                    | climb_descend " " "AND" " " "MAINTAIN" " " level (", " report_point)?
                    | climb_descend " " "AND" " " "MAINTAIN" " " "FLIGHT LEVEL" " " fl_value ("," " " report_point)?
                    | climb_descend " " "TO" " " "AND" " " "MAINTAIN" " " level
                    | climb_descend " " "TO" " " "REACH" " " level " " "AT" " " waypoint
                    | "FURTHER" " " ("DESCENT" | "CLIMB") " " level

climb_descend : "CLIMB" | "DESCEND" | "CLIMBING" | "DESCENDING" | "CLIMB AND MAINTAIN" | "DESCEND AND MAINTAIN"

level : "FLIGHT" " " "LEVEL" " " fl_value
      | altitude_value " " ("FEET" | "FT" | "METRES" | "M")
      | altitude_value

fl_value  : /[0-9]{2,3}/
          | number_word (" " number_word)*
altitude_value : number_word (" " number_word)*
               | /[0-9]{1,5}/

number_word : "ZERO" | "ONE" | "TWO" | "THREE" | "FOUR" | "FIVE"
            | "SIX" | "SEVEN" | "EIGHT" | "NINER" | "HUNDRED"
            | "THOUSAND" | "TEN" | "ELEVEN" | "TWELVE" | "THIRTEEN"
            | "FOURTEEN" | "FIFTEEN" | "SIXTEEN" | "SEVENTEEN"
            | "EIGHTEEN" | "NINETEEN" | "TWENTY" | "THIRTY" | "FORTY"
            | "FIFTY" | "SIXTY" | "SEVENTY" | "EIGHTY" | "NINETY"
            | "OH" | "POINT" | "DECIMAL"

report_point : "REPORT LEAVING" " " level
             | "REPORT REACHING" (" " level)?
             | "REPORT PASSING" " " level
             | "REPORT" " " waypoint

// ── Heading instructions ───────────────────────────────────────────────────
heading_instr : "FLY HEADING" " " heading_value
              | "FLY HEADING" " " heading_value " " ("AND" " ")? speed_instr
              | "HEADING" " " heading_value
              | "HEADING" " " heading_value " " ("AND" " ")? speed_instr
              | ("TURN" | "TURNING") " " "LEFT" " " ("HEADING" " ")? heading_value
              | ("TURN" | "TURNING") " " "RIGHT" " " ("HEADING" " ")? heading_value
              | ("TURN" | "TURNING") " " "LEFT" " " heading_value?
              | ("TURN" | "TURNING") " " "RIGHT" " " heading_value?
              | "PROCEED DIRECT" " " waypoint
              | "DIRECT" " " waypoint
              | "FLY DIRECT" " " waypoint
              | "INTERCEPT" " " ("THE" " ")? ("LOCALIZER" | "ILS" | "LOC") (" " runway_id)?
              | "INTERCEPT" " " runway_id " " ("LOCALIZER" | "ILS" | "LOC")
              | "INTERCEPTING" " " ("THE" " ")? ("LOCALIZER" | "ILS" | "LOC") (runway_id)?
              | "INTERCEPTING" " " runway_id " " ("LOCALIZER" | "ILS" | "LOC")
              | "PROCEEDING" " " "DIRECT" " " waypoint (" " "V" " " "O" " " "R")?

heading_value : /[0-9]{3}/
              | number_word (" " number_word)*

// ── Speed instructions ─────────────────────────────────────────────────────
speed_instr : "REDUCE SPEED TO" " " speed_value " " speed_unit? ("OR" " " "LESS")?
            | "INCREASE SPEED TO" " " speed_value " " speed_unit?
            | "MAINTAIN" " " speed_value " " speed_unit?
            | "MAINTAIN" " " speed_value " " ("KNOTS" | "KT") " " "OR" " " "GREATER"
            | "MAINTAIN" " " speed_value " " ("KNOTS" | "KT") " " "OR" " " "LESS"
            | "MAINTAIN" " " "A" " " speed_value " " "KNOTS" " " "OR" " " "GREATER"?
            | "REDUCE TO MINIMUM APPROACH SPEED"
            | "RESUME NORMAL SPEED"
            | "MAINTAIN PRESENT SPEED"
            | "NO SPEED RESTRICTION"
            | "SPEED" " " speed_value " " ("TO" " " waypoint)?
            | speed_prefix " " "SPEED" " " "TO" " " speed_value " " speed_unit?
            | "SPEED" " " speed_value " " speed_unit
            | "ONE" " " speed_value " " "ON" " " "THE" " " "SPEED"?
            | speed_value " " "ON" " " "THE" " " ("SPEED" | "AIRSPEED")
            | "REDUCING" " " "SPEED" " " "TO" " " speed_value (" " speed_unit)?
            | "REDUCING" " " "TO" " " speed_value (" " speed_unit)?
            | "MAINTAINING" " " speed_value (" " speed_unit)?

speed_prefix : "REDUCE" | "INCREASE"
speed_value  : number_word (" " number_word)*
             | /[0-9]{2,3}/
speed_unit   : "KNOTS" | "KT" | "KILOMETRES PER HOUR"

// ── Frequency / Contact instructions ──────────────────────────────────────
frequency_instr : "CONTACT" " " ("THE" " ")? facility_short " " frequency_value
                | "CONTACT" " " frequency_value
                | "FREQUENCY CHANGE APPROVED"
                | "REMAIN THIS FREQUENCY"
                | "MONITOR" " " ("THE" " ")? facility_short " " frequency_value
                | "MONITOR" " " frequency_value

facility_short : facility_word (" " facility_word)?
facility_word : "TOWER" | "GROUND" | "APPROACH" | "CENTER" | "DEPARTURE"
             | "ARRIVAL" | "CONTROL" | "RADAR" | "BOSTON" | "TRACON"
             | "CLEARANCE" | "DELIVERY" | "ATIS" | "UNICOM"
             | "WASHINGTON" | "DULLES" | "REAGAN" | "NATIONAL"
             | "NEW" | "YORK" | "CHICAGO" | "ATLANTA" | "DALLAS"
             | "MIAMI" | "DENVER" | "SEATTLE" | "ANGELES" | "LOS"
             | "BALTIMORE" | "RICHMOND" | "NORFOLK" | "CLEVELAND"
             | "MINNEAPOLIS" | "DETROIT" | "PITTSBURGH" | "PHILADELPHIA"
frequency_value : /1[0-9]{2}\.[0-9]{1,3}/
                | number_word (" " number_word)* " " "POINT" " " number_word (" " number_word)*
                | number_word (" " number_word)* " " "DECIMAL" " " number_word (" " number_word)*

// ── Clearance instructions ─────────────────────────────────────────────────
clearance_instr : "CLEARED TO" " " destination (" " ("VIA" " " route))?
                | "CLEARED" " " ("FOR" " ")? ("THE" " ")? approach_type " " "APPROACH" (" " "RUNWAY" " " runway_id)?
                | "CLEARED" " " ("FOR" " ")? ("THE" " ")? "VISUAL" (" " runway_id)?
                | "CLEARED" " " ("FOR" " ")? ("THE" " ")? "APPROACH" (" " runway_id)?
                | "CLEARED TO LAND" " " "RUNWAY" " " runway_id
                | "CLEARED TO LAND"
                | "CLEARED ILS" " " "RUNWAY" " " runway_id
                | "CLEARED VISUAL APPROACH" " " "RUNWAY" " " runway_id
                | "CLEARED" " " waypoint (" " waypoint)? " " "VISUAL" " " "APPROACH" (" " "RUNWAY" " " runway_id)?  // named visual (1-2 word location)
                | "CLEARED" " " ("THE" " ")? waypoint (" " waypoint)? " " "VISUAL" " " "APPROACH" (" " runway_id)?
                | "CLEARED DIRECT" " " waypoint
                | "IFR CLEARANCE" " " destination?
                | "RECLEARED" " " destination?
                | "YOU" " " "RE" " " "CLEARED" " " ("FOR" " ")? ("THE" " ")? approach_type? " " "APPROACH"? (" " runway_id)?
               | "INFORMATION" " " /[A-Z]/  // ATIS information identifier
destination : /[A-Z]{3,4}/
route : waypoint (" " waypoint)*
waypoint : /[A-Z]{3,10}/  // expanded from 3-6 to 3-10 chars for WASHINGTON, JULIETT etc.
approach_type : "ILS" | "LOCALIZER" | "LOC" | "VOR" | "RNAV" | "VISUAL" | "GPS" | "NDB"
              | "I" " " "L" " " "S"    // spoken letter-by-letter

// ── Taxi instructions ──────────────────────────────────────────────────────
taxi_instr : "TAXI TO" " " location (" " "VIA" " " taxi_route)?
           | "TAXI" " " location (" " "VIA" " " taxi_route)?
           | "HOLD SHORT" " " ("OF" " ")? location
           | "HOLD SHORT OF" " " location
           | "HOLD POSITION"
           | "CONTINUE TAXI"
           | "EXPEDITE TAXI" (" " reason)?
           | "TAXI INTO POSITION AND HOLD" (" " runway_id)?
           | "PROCEED TO" " " location (" " "FOR" " " "RUNWAY" " " runway_id)?
           | "WILL" " " "HOLD" " " "SHORT" " " "OF" " " ("YOUR" " ")? "RUNWAY"

location : "RUNWAY" " " runway_id | "GATE" " " /[A-Z0-9]+/ | waypoint
taxi_route : location (" " location)*
runway_id : /[0-9]{1,2}[LRC]?/
          | number_word (" " number_word)* (" " "LEFT" | " " "RIGHT" | " " "CENTER")?
          | number_word (" " number_word)* " " airline_word
reason : /[A-Z ]+/

// ── Takeoff instructions ───────────────────────────────────────────────────
takeoff_instr : "CLEARED FOR TAKEOFF" " " "RUNWAY" " " runway_id
              | "CLEARED FOR TAKEOFF"
              | "LINE UP AND WAIT" " " "RUNWAY" " " runway_id
              | "LINE UP AND WAIT"
              | "HOLD SHORT OF RUNWAY" " " runway_id
              | "TAKEOFF IMMEDIATELY"
              | "CANCEL TAKEOFF CLEARANCE"
              | "HOLD POSITION" ", " "CANCEL TAKEOFF"

// ── Approach instructions ──────────────────────────────────────────────────
approach_instr : "CLEARED" " " approach_type " " "APPROACH"
               | "EXPECT" " " approach_type " " "APPROACH" (" " "RUNWAY" " " runway_id)?
               | "REPORT" " " ("ESTABLISHED" | "LOCALIZER") (" " "RUNWAY" " " runway_id)?
               | "GO AROUND" (" " missed_approach_instr)?
               | "CONTINUE APPROACH"
               | "CLEARED VISUAL APPROACH" " " "RUNWAY" " " runway_id
               | number_word (" " number_word)* " " "FROM" " " waypoint " " ("INTERCEPT" " ")? ("THE" " ")? approach_type? (" " "APPROACH")? (" " runway_id)?

missed_approach_instr : "CLIMB AND MAINTAIN" " " level
                      | "FLY HEADING" " " heading_value

// ── Holding instructions ───────────────────────────────────────────────────
hold_instr : "HOLD" " " hold_direction " " "OF" " " waypoint ("," " " hold_details)?
           | "HOLD" " " waypoint (" " hold_details)?
           | "CLEARED TO" " " waypoint ", " "HOLD" " " hold_direction?
           | "HOLD POSITION"
           | "EXPECT" " " "FURTHER CLEARANCE" " " "AT" " " time_value

hold_direction : "NORTH" | "SOUTH" | "EAST" | "WEST"
               | "NORTHEAST" | "NORTHWEST" | "SOUTHEAST" | "SOUTHWEST"
hold_details : ("LEFT" | "RIGHT") (" " "HAND" (" " "PATTERN")?)?
time_value : /[0-9]{4}/

// ── Report / Readback ──────────────────────────────────────────────────────
report_instr : "REPORT" " " report_type
readback_instr : "READBACK CORRECT"
               | "WILCO" | "AFFIRM" | "NEGATIVE" | "ROGER" | "UNABLE"
               | "STANDBY" | "SAY AGAIN" | "CORRECTION"

report_type : "PASSING" " " (level | waypoint)
            | "ESTABLISHED" (" " "ON" " " ("LOCALIZER" | "ILS"))?
            | "VISUAL"
            | "DOWNWIND" | "BASE" | "FINAL"
            | "LEAVING" " " level
            | "REACHING" " " level
            | "RUNWAY VACATED"
            | "FULLY ESTABLISHED"
            | "RUNWAY" " " "IN" " " "SIGHT"
            | "POSITION"
            | "VISUAL" " " "SEPARATION"  // visual separation from traffic

// ── IDENT ──────────────────────────────────────────────────────────────────
ident_instr : "SQUAWK" " " squawk_code
            | "SQUAWK IDENT" | "SQUAWK STANDBY" | "SQUAWK CHARLIE"
            | "SQUAWK NORMAL" | "IDENT"
            | "RADAR CONTACT" (" " position_info)?
            | "RADAR CONTACT LOST"
            | "STOP SQUAWK"

squawk_code : /[0-7]{4}/ | number_word (" " number_word)*
position_info : waypoint | number_word (" " number_word)*

// ── Traffic information ────────────────────────────────────────────────────
traffic_info : "TRAFFIC" " " position_clock /[ ]O'CLOCK/ (" " distance)? (" " traffic_type)? (" " action)?
             | "NO REPORTED TRAFFIC"
             | "NO" " " "TRAFFIC" " " "OBSERVED"
             | "TRAFFIC" " " traffic_description
             | "TRAFFIC LANDING" " " "RUNWAY" " " runway_id (" " traffic_action)?
             | "TRAFFIC LANDING" " " runway_id (" " traffic_action)?
             | "TRAFFIC" " " "IN" " " "SIGHT"
             | "TRAFFIC" " " "NO" " " "LONGER" " " "A" " " "FACTOR"
             | "NO" " " "LONGER" " " "A" " " "FACTOR"

position_clock : number_word (" " number_word)?
distance : number_word (" " number_word)* " " ("MILES" | "MILE" | "NM" | "KILOMETRES")?
traffic_type : "UNKNOWN" | "VFR" | "IFR" | "MILITARY" | "HELICOPTER"

traffic_description : "ALERT"
                    | "SEPARATION LOST"
                    | "CONFLICT"
                    | "ALERT TRAFFIC ADVISORY"
                    | "SAME DIRECTION"
                    | "OPPOSITE DIRECTION"
                    | "CROSSING"
                    | "OVERTAKING"
                    | traffic_type (" " distance)? (" " direction)?
                    | "HEAVY" (" " distance)? (" " direction)?
                    | "SUPER" (" " distance)? (" " direction)?
                    | "LARGE" (" " distance)? (" " direction)?

// Add direction rule if not already present:
direction : "NORTHBOUND" | "SOUTHBOUND" | "EASTBOUND" | "WESTBOUND"
          | "NORTH" | "SOUTH" | "EAST" | "WEST"
          | "NORTHEAST" | "NORTHWEST" | "SOUTHEAST" | "SOUTHWEST"
traffic_action : "WILL HOLD SHORT" | "WILL SHORT" | "HOLDING SHORT"
action : "REPORT IN SIGHT" | "PASS BEHIND" | "PASS AHEAD" | "IN SIGHT"

// Add radar_contact_instr to instruction alternatives
radar_contact_instr : "RADAR" " " "CONTACT" (" " level)?


confirm_instr : "CONFIRM" " " confirm_subject
confirm_subject : "LEVEL" | "ALTITUDE" | "HEADING" | "SPEED"
                | "CLIMB" " " "TO" " " level    // CONFIRM CLIMB TO level
                | "DESCEND" " " "TO" " " level  // CONFIRM DESCEND TO level
                | "SQUAWK"                       // CONFIRM SQUAWK code
                | "DEPARTED" " " waypoint
                | "DEPARTURE" " " waypoint
                | "DEPARTED" " " waypoint | "SQUAWK" | "CALLSIGN"

join_instr : "JOIN" " " airway_id (" " "RESUME" " " "OWN" " " "NAVIGATION")?
// airway_id : "JULIETT" " " number_word (" " number_word)*  // J149


// Add route_instr to instruction alternatives
route_instr : "JOIN" " " airway_id (" " "RESUME" " " "OWN" " " "NAVIGATION")?
            | "RESUME" " " "OWN" " " "NAVIGATION"
            | "JOIN" " " ("THE" " ")? ("LOCALIZER" | "ILS" | "LOC")
            | "TO" " " "JOIN" " " ("THE" " ")? ("LOCALIZER" | "ILS" | "LOC")
airway_id   : airline_word " " number_word (" " number_word)*    // J149 spoken as "JULIETT ONE FOUR NINER"
            | /[A-Z]/ " " number_word (" " number_word)*             // single letter form


// New pattern for altitude departure reports:
leaving_instr : "LEAVING" " " level " " ("CLIMBING" | "DESCENDING") " " "TO" " " level

// ── ATIS information identifier ────────────────────────────────────────────
information_instr : "INFORMATION" " " airline_word    // INFORMATION VICTOR, FOXTROT, PAPA etc.

// ── General fallback ──────────────────────────────────────────────────────
// Used for corpus training signal even for utterances not covered above
general_instr : word (" " word)+
word : /[A-Z']+/

%ignore /\n/

// ── STEP 2: Add pilot rules at end of file ────────────────────────

// ── Pilot utterance top level ─────────────────────────────────────
pilot_utterance : readback
                | pilot_report
                | pilot_request
                | pilot_contact
                | pilot_general             // catch-all for non-standard pilot speech

// ── Readback: instruction content + callsign at end ───────────────
// ICAO standard: pilot reads back instruction verbatim + appends callsign
// e.g. "TURN LEFT HEADING ONE EIGHT ZERO DELTA SIX"
// e.g. "TURNING LEFT HEADING ONE EIGHT ZERO DELTA SIX"  (progressive)
// e.g. "LEFT THREE THREE ZERO FOR DELTA TWO FIFTY EIGHT" (abbreviated)
readback : readback_body " " callsign_phrase
         | readback_body                    // readback without callsign (non-ICAO but common)

readback_body : instruction                 // exact repeat of controller instruction
              | readback_modified           // progressive / abbreviated form

readback_modified : ("TURNING"|"TURN") " " ("LEFT"|"RIGHT") (" " "HEADING")? " " heading_value
                  | ("LEFT"|"RIGHT") " " heading_value (" " "FOR")?
                  | "HEADING" " " heading_value (" " ("LEFT"|"RIGHT"))?
                  | ("CLIMBING"|"DESCENDING") " " "TO" " " level
                  | ("CLIMBING"|"DESCENDING") " " "AND" " " "MAINTAINING" " " level
                  | "LEAVING" " " level " " ("CLIMBING"|"DESCENDING") " " "TO" " " level
                  | "LEAVING" " " level " " ("CLIMBING"|"DESCENDING")
                  | "LEVELLING" " " "OFF" (" " "AT" " " level)?
                  | "LEVEL" " " level
                  | "MAINTAINING" " " level
                  | "REDUCING" " " "TO" " " speed_value (" " speed_unit)?
                  | "SLOWING" " " "TO" " " speed_value (" " speed_unit)?
                  | ("ROGER"|"WILCO") " " instruction  // ack + readback

// ── Pilot position report ─────────────────────────────────────────
// ICAO: callsign + position/level information
// e.g. "DELTA SIX WITH YOU AT FIVE THOUSAND"
// e.g. "AMERICAN SEVEN THIRTY SIX FIELD IN SIGHT"
// e.g. "UNITED FOUR FIFTY LEAVING THREE THOUSAND CLIMBING TO FIVE THOUSAND"
pilot_report : callsign_phrase " " pilot_level_report
             | callsign_phrase " " "WITH" " " "YOU" (" " "AT" " " level)?
             | callsign_phrase " " "FIELD" " " "IN" " " "SIGHT"
             | callsign_phrase " " "RUNWAY" " " "IN" " " "SIGHT"
             | callsign_phrase " " "TRAFFIC" " " "IN" " " "SIGHT"
             | callsign_phrase " " "GOING" " " "AROUND"
             | callsign_phrase " " "MISSED" " " "APPROACH"

pilot_level_report : "LEAVING" " " level (" " ("CLIMBING"|"DESCENDING") " " "TO" " " level)?
                   | "PASSING" " " level
                   | "LEVEL" " " level
                   | "AT" " " level
                   | "ESTABLISHED" (" " "ON" " " ("LOCALIZER"|"ILS"|"LOC"))?
                   | "APPROACHING" " " waypoint
                   | "OVER" " " waypoint

// ── Pilot request ─────────────────────────────────────────────────
// ICAO: [callsign] REQUEST [item]
// e.g. "DELTA SIX REQUEST DESCENT TO THREE THOUSAND"
// e.g. "REQUEST LOWER"
pilot_request : callsign_phrase " " "REQUEST" " " request_body
              | "REQUEST" " " request_body

request_body : instruction                              // full instruction as request
             | "LOWER" | "HIGHER"                       // shorthand altitude requests
              | "DESCENT" " " "TO" " " level      // noun form in pilot requests
              | "CLIMB" " " "TO" " " level         // imperative form
             | "VECTORS" (" " "TO" " " ("THE" " ")? ("ILS"|"LOCALIZER"|"LOC"|approach_type))?
             | "DIRECT" " " waypoint
             | "VISUAL" " " "APPROACH" (" " "RUNWAY" " " runway_id)?
             | "CLEARANCE" (" " "TO" " " destination)?
             | "DEVIATION" | "WEATHER" " " "DEVIATION"
             | level                                    // "REQUEST FIVE THOUSAND"

// ── Pilot initial contact ─────────────────────────────────────────
// ICAO: facility + callsign [WITH YOU] [AT level]
// e.g. "BOSTON APPROACH DELTA SIX FORTY HEAVY WITH YOU AT FIVE THOUSAND"
// e.g. "DELTA SIX BOSTON APPROACH"  (abbreviated)
pilot_contact : facility_short " " callsign_phrase (" " "WITH" " " "YOU")? (" " "AT" " " level)?
              | callsign_phrase " " "WITH" " " facility_short (" " "AT" " " level)?
              | facility_short " " callsign_phrase " " level  // position report at contact

// ── Pilot catch-all (non-standard pilot speech) ───────────────────
// Handles informal/non-standard pilot transmissions that don't fit
// the structured patterns above. Uses inline regex to avoid
// dependency on 'word' rule which is disabled in strict grammar.
pilot_general : /[A-Z']+/ " " /[A-Z']+/ (" " /[A-Z']+/)*

